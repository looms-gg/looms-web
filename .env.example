# Copy to .env (and/or keep VITE_* in .env.local). Never commit real secrets.

# Supabase CLI (migrations during deploy). Create at:
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Optional override; otherwise derived from VITE_SUPABASE_URL host.
# SUPABASE_PROJECT_REF=

# Vite / browser (required for production build)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. Default /looms-web/ for project Pages.
# For a custom domain later, set VITE_BASE=/
# VITE_BASE=/looms-web/
