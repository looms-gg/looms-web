{{!--
  looms transactional email shell.
  Copy this file and replace the marked regions to add a new email.
  Palette + rules: docs/platform/brand-and-content-guide.md §3.
  Accent stays scarce: the CTA and one link color. No other pink.
--}}
<!DOCTYPE html>
<html lang="en" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="color-scheme" content="only light">
  <meta name="supported-color-schemes" content="only light">
  <title>looms</title>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;700;800&display=swap" rel="stylesheet">
  <!--[if mso]>
  <noscript><xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml></noscript>
  <![endif]-->
  <style>
    :root { color-scheme: only light; supported-color-schemes: only light; }
    body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
    table, td { mso-table-lspace: 0; mso-table-rspace: 0; }
    img { -ms-interpolation-mode: bicubic; border: 0; height: auto; line-height: 100%; outline: none; text-decoration: none; }
    body { margin: 0; padding: 0; width: 100% !important; background-color: #131418; }
    a { text-decoration: none; }
    h1, h2, h3 { margin: 0; }
    p { margin: 0; }
    .link { color: #e884a8 !important; font-weight: 700; text-decoration: underline; }
    .btn:hover { background-color: #b83a6c !important; }
    @media only screen and (max-width: 520px) {
      .panel-td { padding: 32px 24px 28px 24px !important; }
    }
  </style>
</head>
<body style="background-color: #131418;">

  <div style="display: none; font-size: 1px; color: #131418; line-height: 1px; max-height: 0; max-width: 0; opacity: 0; overflow: hidden;">
    {{preheader}}
  </div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #131418;">
    <tr>
      <td align="center" style="padding: 32px 16px 40px 16px;">

        <!--[if mso]><table role="presentation" width="480" cellpadding="0" cellspacing="0" border="0"><tr><td><![endif]-->
        <table role="presentation" width="480" cellpadding="0" cellspacing="0" border="0" style="width: 100%; max-width: 480px;">

          {{!-- ═══ HEADER: wordmark, centered like the app's auth modal ═══ --}}
          <tr>
            <td align="center" style="padding: 0 24px 24px 24px;">
              <img src="https://looms.gg/brand/looms-full.png" width="168" height="59" alt="looms" style="display: block; width: 168px; height: auto;">
            </td>
          </tr>

          {{!-- ═══ PANEL ═══ --}}
          <tr>
            <td>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #181a22; border-radius: 18px; border: 1px solid #2a2c37;">
                <tr>
                  <td class="panel-td" align="left" style="padding: 40px 36px 36px 36px;">

                    {{content}}

                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 32px 0 20px 0;">
                      <tr>
                        <td style="border-top: 2px dashed #333542; font-size: 0; line-height: 0;">&nbsp;</td>
                      </tr>
                    </table>

                    <p align="left" style="font-family: Nunito, 'Segoe UI', Arial, sans-serif; font-size: 13px; line-height: 1.6; color: #9a9aa6;">
                      {{fineprint}}
                    </p>

                  </td>
                </tr>
              </table>
            </td>
          </tr>

          {{!-- ═══ FOOTER ═══ --}}
          <tr>
            <td align="center" style="padding: 20px 24px 0 24px;">
              <p style="font-family: Nunito, 'Segoe UI', Arial, sans-serif; font-size: 12px; line-height: 1.6; color: #8b8e9b; margin: 0;">
                Free to style, export, and wear. Unofficial Minecraft fan project.<br>
                <a class="link" href="https://looms.gg/" style="color: #8b8e9b !important; font-weight: 400;">looms.gg</a>
                &nbsp;·&nbsp;
                <a class="link" href="https://discord.gg/UNTRgHBBPb" style="color: #8b8e9b !important; font-weight: 400;">Discord</a>
              </p>
            </td>
          </tr>

        </table>
        <!--[if mso]></td></tr></table><![endif]-->

      </td>
    </tr>
  </table>
</body>
</html>
